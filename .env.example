# PayPhone Proxy — plantilla de entorno
#
# Copia este archivo como .env y reemplaza todos los valores replace-with-*.
# Nunca guardes aquí tokens reales, claves de proyecto ni StoreID reales si el
# archivo va a publicarse. Un despliegue representa una aplicación Developer
# de PayPhone; usa otro .env y otro PAYPHONE_TOKEN para cada ambiente.

# Servidor HTTP local. El reverse proxy público debe terminar TLS y reenviar
# las rutas de checkout y de respuesta a este puerto.
HTTP_ADDR=:8080

# Base SQLite local. En Docker usa /data/payments.db y monta un volumen.
DATABASE_PATH=./data/payments.db

# Origen desde el que el comprador abrirá /checkout/{token}. Debe coincidir
# exactamente con el Dominio Web registrado en la aplicación WEB de PayPhone.
PUBLIC_BASE_URL=https://registered.example.com
# Alias legacy aceptado si PUBLIC_BASE_URL no está definido:
# PAYPHONE_WEB_DOMAIN=https://registered.example.com

# Ruta usada cuando no se define PAYPHONE_RESPONSE_URL.
PAYPHONE_RETURN_PATH=/payphone/return

# URL completa registrada como URL de Respuesta en PayPhone Developer. Puede
# estar en otro host (por ejemplo, un subdominio), pero ese host debe apuntar
# al mismo proxy y publicar la ruta indicada.
PAYPHONE_RESPONSE_URL=https://payment.example.com/payphone/response

# API oficial de PayPhone y token de ESTA aplicación Developer.
PAYPHONE_BASE_URL=https://pay.payphonetodoesposible.com/api
PAYPHONE_TOKEN=replace-with-payphone-developer-token

# Mapa JSON: alias interno -> StoreID autorizado por este token.
# Puedes registrar tantos alias como necesites; varios alias también pueden
# apuntar al mismo StoreID si esa es tu organización.
PAYPHONE_STORES_JSON='{"production":"replace-with-production-store-id","development":"replace-with-development-store-id"}'

# Mapa JSON: proyecto interno -> configuración. Cada api_key es una clave
# propia del proxy (no es el token PayPhone), debe ser única y aleatoria.
# return_url es opcional; si se omite, el callback devuelve JSON al navegador.
PAYMENT_PROJECTS_JSON='{"proyecto-produccion":{"api_key":"replace-with-production-project-key","store":"production","return_url":"https://project.example/payments/result"},"proyecto-desarrollo":{"api_key":"replace-with-development-project-key","store":"development","return_url":"https://dev-project.example/payment-result"}}'
